# iHomeland local coordination and tool state
/.agents/
/.codex/
/.local/
/.tools/

# Machine-local editor state
**/.idea/
**/.vs/
**/.vscode/
/.clang-format
*.suo
*.user
*.userprefs

# Operating-system metadata
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Secrets and local environment overrides
.env
.env.*
!.env.example

# Unity client: generated and machine-local directories
/client/[Ll]ibrary/
/client/[Tt]emp/
/client/[Oo]bj/
/client/[Bb]in/
/client/[Ll]ogs/
/client/[Uu]ser[Ss]ettings/
/client/[Mm]emoryCaptures/
/client/[Rr]ecordings/
/client/[Cc]aptures/

# Unity client: local builds
/client/[Bb]uild/
/client/[Bb]uilds/

# Unity client: generated IDE files
/client/*.csproj
/client/*.unityproj
/client/*.sln
/client/*.slnx
/client/*.pidb
/client/*.booproj

# Do not ignore client/Packages: manifest.json, packages-lock.json, and any
# future embedded packages are reproducible product inputs.

# Go server: local caches and test output
/server/.gocache/
/server/.gomodcache/
/server/coverage.out
/server/*.test

# C++ simulation: out-of-source CMake output and user-local presets
/simulation/build/
/simulation/out/
/simulation/cmake-build-*/
/simulation/CMakeFiles/
/simulation/CMakeCache.txt
/simulation/cmake_install.cmake
/simulation/CTestTestfile.cmake
/simulation/compile_commands.json
/simulation/CMakeUserPresets.json
