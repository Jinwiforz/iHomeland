# iHomeland git ignore rules

## OS files
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*~

## Local environment
.env
.env.local
.env.*.local

## IDEs and editors
.idea/
.vs/
.vscode/

# Local AI / Agent tooling
.agents/
.codex/

*.suo
*.user
*.userprefs
*.iws
*.iml
.history/
client/.vsconfig

## Codex/local tooling caches
.tools/
server/.gocache/
server/.gomodcache/

## Go
*.test
*.out
go.work.sum

## Generated protocol output
server/internal/protocol/pb/

## Server build/runtime output
server/bin/
server/dist/
server/tmp/

## Unity project generated files
client/[Ll]ibrary/
client/[Tt]emp/
client/[Oo]bj/
client/[Bb]uild/
client/[Bb]uilds/
client/[Ll]ogs/
client/[Uu]ser[Ss]ettings/
client/[Mm]emory[Cc]aptures/
client/Recordings/

## Unity generated IDE files
client/*.csproj
client/*.unityproj
client/*.sln
client/*.slnx
client/*.suo
client/*.tmp
client/*.pidb
client/*.booproj
client/*.svd
client/*.pdb
client/*.mdb
client/*.opendb
client/*.VC.db

## Unity crash/build artifacts
client/sysinfo.txt
client/*.stackdump
client/*.apk
client/*.aab
client/*.unitypackage
client/[Cc]rash[Rr]eports/

## Unity asset metadata
# Keep .meta files for tracked assets. Only generated/cache folders above are ignored.
!client/Assets/**/*.meta
!client/Packages/manifest.json
!client/Packages/packages-lock.json
!client/ProjectSettings/**

## Generated protocol Unity metadata
client/Assets/App/Scripts/Protocol.meta
client/Assets/App/Scripts/Protocol/Pb.meta
client/Assets/App/Scripts/Protocol/Pb/
client/Assets/App/Scripts/Generated.meta
client/Assets/App/Scripts/Generated/
