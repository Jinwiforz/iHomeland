{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "change",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 4,
            "maxLength": 240,
            "pattern": "^[^\\r\\n]+$"
          }
        }
      }
    }
  }
}
