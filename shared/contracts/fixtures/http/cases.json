{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "version-success",
      "request": {
        "method": "GET",
        "path": "/v1/version"
      },
      "response": {
        "status": 200,
        "body": {
          "minimumClientVersion": "0.1.0",
          "protocolVersion": 1,
          "serverVersion": "0.1.0"
        }
      }
    },
    {
      "name": "login-invalid-credentials",
      "request": {
        "method": "POST",
        "path": "/v1/auth/login",
        "body": {
          "password": "fixture-password-not-secret",
          "username": "fixture-user"
        }
      },
      "response": {
        "status": 401,
        "body": {
          "code": 102,
          "messageKey": "error.auth.invalid_credentials",
          "requestId": "fixture-request-id",
          "retryable": false
        }
      }
    },
    {
      "name": "register-username-conflict",
      "request": {
        "method": "POST",
        "path": "/v1/auth/register",
        "body": {
          "displayName": "Fixture User",
