{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihomeland.local/schemas/client-qualification/manual-checklist.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "qualificationVersion", "contractDigest", "buildDigests", "profiles", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "qualificationVersion": { "const": "client-v1" },
    "contractDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "buildDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "release"],
      "properties": {
        "development": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "release": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "dataProfile", "buildArtifact", "storageArtifact"],
        "properties": {
          "role": { "enum": ["owner", "visitor"] },
          "dataProfile": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
          "buildArtifact": { "const": "development/iHomeland.exe" },
          "storageArtifact": { "const": "manual-player-storage" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "steps"],
        "properties": {
          "scenarioId": { "enum": ["two-player-product-flow", "two-player-channel-faults", "two-player-server-restart"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    }
  }
}
