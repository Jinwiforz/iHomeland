{
  "schemaVersion": "simulation-control-v1",
  "caseId": "battle-listener-ticket-session-control",
  "category": "battle-control",
  "listenerStatus": {
    "states": [
      "starting",
      "ready",
      "failed",
      "stopped"
    ],
    "identityFields": [
      "simulationNodeId",
      "listenerGeneration",
      "bindHost",
      "bindPort",
      "advertisedHost",
      "advertisedPort",
      "wireIdentity",
      "cryptoIdentity"
    ]
  },
  "ticketLifecycle": {
    "states": [
      "installed",
      "consumed",
      "revoked",
      "expired",
      "missing"
    ],
    "installRequiredFields": [
      "installRequestId",
      "ticketId",
      "bindingFingerprint",
      "binding",
      "proofKey"
    ],
    "proofKeyRule": "runtime-only-secret-redacted-in-fixtures-logs-reports-and-storage",
    "replayRule": "same-request-and-binding-replays-original-state-and-slot",
    "conflictRule": "same-request-or-ticket-with-field-drift-is-rejected"
  },
  "sessionLifecycle": {
    "requestKind": "battle.session.revoke",
    "receiptKind": "battle.session.closed",
    "identityFields": [
      "revokeRequestId",
      "battleSessionId",
      "sessionGeneration",
      "simulationInstanceId",
      "assignmentFingerprint"
    ],
    "closedRequiredFields": [
      "closeReason",
      "packetDispatchStopped"
    ]
  },
  "qualificationSnapshot": {
    "requestKind": "battle_qualification_snapshot_request",
    "receiptKind": "battle_qualification_snapshot_receipt",
    "mode": "explicit-run-only",
    "sampleSequence": "starts-at-one-and-advances-only-after-valid-receipt",
    "identityFields": [
      "qualificationRunId",
      "sampleSequence",
      "simulationNodeId",
      "simulationInstanceId",
      "assignmentFingerprint"
    ],
    "counterPolicy": "closed-low-sensitive-monotonic-and-read-does-not-reset",
    "productionDisposition": "rejected"
  },
  "expectations": [
    "frame-size-at-most-65536",
    "nonce-and-sequence-validated-before-dispatch",
    "all-payloads-closed",
    "request-replay-compares-all-immutable-fields",
    "proof-key-only-on-ticket-install",
    "secret-never-in-fixture-log-report-or-storage",
    "qualification-snapshot-does-not-create-listener-or-file-management-plane",
    "qualification-snapshot-rejects-production-old-run-old-node-and-out-of-order-sample"
  ]
}
