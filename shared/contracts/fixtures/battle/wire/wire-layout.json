      { "name": "flags", "offset": 6, "width": 2, "encoding": "uint16-be", "constraint": "zero-until-registered" },
      { "name": "session_id_digest", "offset": 8, "width": 8, "encoding": "opaque", "constraint": "nonzero-routing-handle" },
      { "name": "battle_session_generation", "offset": 16, "width": 4, "encoding": "uint32-be", "constraint": "positive" },
      { "name": "key_epoch", "offset": 20, "width": 4, "encoding": "uint32-be", "constraint": "nonce-prefix" },
      { "name": "packet_sequence", "offset": 24, "width": 8, "encoding": "uint64-be", "constraint": "positive-monotonic-no-wrap" },
      { "name": "protected_payload_length", "offset": 32, "width": 2, "encoding": "uint16-be", "constraint": "excludes-aead-tag" },
      { "name": "endpoint_generation", "offset": 34, "width": 4, "encoding": "uint32-be", "constraint": "positive" },
      { "name": "binding_discriminator", "offset": 38, "width": 8, "encoding": "opaque", "constraint": "nonzero-ticket-derived" },
      { "name": "reserved", "offset": 46, "width": 2, "encoding": "zero", "constraint": "must-be-zero" }
    ]
  },
  "raw_route_header": {
    "size_bytes": 16,
    "byte_order": "network-big-endian",
    "fields": [
