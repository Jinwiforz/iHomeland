      { "name": "payload_length", "offset": 4, "width": 2, "encoding": "uint16-be", "constraint": "exact-protobuf-bytes" },
      { "name": "partition_index", "offset": 6, "width": 1, "encoding": "uint8", "constraint": "less-than-partition-count" },
      { "name": "partition_count", "offset": 7, "width": 1, "encoding": "uint8", "constraint": "positive-bounded" },
      { "name": "application_sequence", "offset": 8, "width": 8, "encoding": "uint64-be", "constraint": "route-policy" }
    ]
  },
  "snapshot_acknowledgement": {
    "message_ids": [3002, 3003],
    "protobuf_field": "last_processed_input_tick",
    "field_number": 7,
    "scalar_type": "uint64",
    "presence": "explicit-required",
    "initial_value": 0,
    "scope": "authenticated-actor-and-mapping-generation",
    "partition_policy": "identical-across-complete-set-before-publication",
    "maximum_varint_bytes": 10,
    "maximum_datagram_bytes": 1200,
    "route_payload_budgets": {
      "3002": 1040,
      "3003": 900
    }
  },
  "snapshot_entity_state": {
    "message_ids": [3002, 3003, 3005],
    "transform_message": "ihomeland.battle.v1.QuantizedTransform",
    "required_scalar_fields": [
      { "name": "position_x_mm", "field_number": 1, "range": "sint32" },
      { "name": "position_y_mm", "field_number": 2, "range": "sint32" },
      { "name": "position_z_mm", "field_number": 3, "range": "sint32" },
      { "name": "yaw_millidegrees", "field_number": 4, "range": "[-180000,180000)" },
      { "name": "velocity_x_mm_per_second", "field_number": 5, "range": "sint32" },
      { "name": "velocity_y_mm_per_second", "field_number": 6, "range": "sint32" },
      { "name": "velocity_z_mm_per_second", "field_number": 7, "range": "sint32" }
    ],
    "scalar_presence": "explicit-required-in-full-delta-and-spawn-state",
    "delta_state_mask": {
      "transform": 1,
      "health_milli": 2,
      "state_flags": 4,
      "known_mask": 7,
      "presence_policy": "exact-match"
    },
    "state_flags": {
      "phase_mask": 15,
      "grounded_flag": 16,
      "dead_flag": 2147483648,
      "known_mask": 2147483679,
      "unknown_policy": "reject",
      "compatibility": "bits-0-through-3-remain-phase-bit-4-is-grounded-bit-31-is-dead"
    }
  },
  "kcp_segment_header": {
    "size_bytes": 24,
    "byte_order": "little-endian",
    "source_identity": "kcp-2.1.1",
    "fields": [
      { "name": "conv", "offset": 0, "width": 4, "encoding": "uint32-le", "constraint": "battle-session-derived" },
      { "name": "cmd", "offset": 4, "width": 1, "encoding": "uint8", "constraint": "81=push,82=ack,83=wask,84=wins" },
      { "name": "frg", "offset": 5, "width": 1, "encoding": "uint8", "constraint": "kcp-bounded-fragment" },
      { "name": "wnd", "offset": 6, "width": 2, "encoding": "uint16-le", "constraint": "maximum-64" },
      { "name": "ts", "offset": 8, "width": 4, "encoding": "uint32-le", "constraint": "kcp-monotonic-ms" },
      { "name": "sn", "offset": 12, "width": 4, "encoding": "uint32-le", "constraint": "kcp-segment-sequence" },
      { "name": "una", "offset": 16, "width": 4, "encoding": "uint32-le", "constraint": "kcp-unacknowledged-sequence" },
      { "name": "len", "offset": 20, "width": 4, "encoding": "uint32-le", "constraint": "exact-segment-payload" }
    ]
  },
  "kcp_route_envelope": {
    "size_bytes": 16,
    "byte_order": "network-big-endian",
    "fields": [
      { "name": "message_id", "offset": 0, "width": 4, "encoding": "uint32-be", "constraint": "registered-kcp-route" },
      { "name": "payload_length", "offset": 4, "width": 2, "encoding": "uint16-be", "constraint": "exact-reassembled-protobuf-bytes" },
      { "name": "route_flags", "offset": 6, "width": 2, "encoding": "uint16-be", "constraint": "zero-until-registered" },
      { "name": "application_sequence", "offset": 8, "width": 8, "encoding": "uint64-be", "constraint": "route-policy" }
    ]
  },
  "transport_control_envelope": {
    "size_bytes": 8,
    "byte_order": "network-big-endian",
    "authentication": "secure-packet-kind-control",
    "fields": [
      { "name": "magic", "offset": 0, "width": 4, "encoding": "ascii", "constraint": "IHBC" },
      { "name": "version", "offset": 4, "width": 1, "encoding": "uint8", "constraint": "1" },
      { "name": "kind", "offset": 5, "width": 1, "encoding": "uint8", "constraint": "1-through-8-registered" },
      { "name": "payload_length", "offset": 6, "width": 2, "encoding": "uint16-be", "constraint": "exact-trailing-bytes" }
    ]
  },
  "transport_control_messages": [
    { "kind": 1, "name": "rebind-request", "direction": "c2s-current-endpoint", "payload_bytes": 34, "fields": "candidate-address-16,candidate-port-u16be,nonce-16" },
    { "kind": 2, "name": "rebind-challenge", "direction": "s2c-candidate-endpoint", "payload_bytes": 48, "fields": "current-generation-u32be,next-generation-u32be,nonce-16,expires-at-u64be,cookie-16" },
    { "kind": 3, "name": "rebind-confirm", "direction": "c2s-candidate-endpoint", "payload_bytes": 48, "fields": "exact-rebind-challenge-payload" },
    { "kind": 4, "name": "rebind-committed", "direction": "s2c-candidate-before-generation-commit", "payload_bytes": 20, "fields": "next-generation-u32be,nonce-16" },
    { "kind": 5, "name": "rekey-proposal", "direction": "c2s-current-endpoint", "payload_bytes": 32, "fields": "rollover-nonce-32" },
    { "kind": 6, "name": "rekey-committed", "direction": "s2c-before-epoch-commit", "payload_bytes": 32, "fields": "exact-rollover-nonce-32" },
    { "kind": 7, "name": "close-request", "direction": "c2s-current-endpoint", "payload_bytes": 1, "fields": "close-code-u8" },
    { "kind": 8, "name": "close-acknowledged", "direction": "s2c-before-session-destroy", "payload_bytes": 1, "fields": "exact-close-code-u8" }
  ],
  "datagram_equation": {
    "raw": "48 secure + 16 raw + protobuf + 16 tag <= 1200",
    "kcp": "48 secure + 24 kcp + segment-payload + 16 tag <= 1200",
    "control": "48 secure + 8 control + fixed-control-payload + 16 tag <= 1200",
    "ipv6_udp_budget_bytes": 48,
    "ip_fragmentation": "forbidden"
  }
