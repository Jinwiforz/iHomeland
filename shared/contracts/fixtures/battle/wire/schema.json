{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ihomeland.local/schemas/battle-wire-v1.json",
  "title": "iHomeland Secure Battle Wire Source Corpus",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/binding"
    },
    {
      "$ref": "#/$defs/limits"
    },
    {
      "$ref": "#/$defs/wire_suite"
    },
    {
      "$ref": "#/$defs/secret_policy"
    },
    {
      "$ref": "#/$defs/wire_layout"
    },
    {
      "$ref": "#/$defs/canonical_golden"
    },
    {
      "$ref": "#/$defs/malformed_corpus"
    },
    {
      "$ref": "#/$defs/crypto_vectors"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_json_path": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./-]*\\.json$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "base": {
      "type": "object",
      "required": [
        "format_version",
        "corpus_version",
        "document_kind"
      ],
      "properties": {
        "format_version": {
          "const": "1"
        },
        "corpus_version": {
          "const": "battle-wire-v1"
        },
        "document_kind": {
          "type": "string"
        }
      }
    },
    "manifest_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "document_kind",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_json_path"
        },
        "document_kind": {
          "$ref": "#/$defs/identity"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "schema_path",
            "schema_sha256",
            "required_domains",
            "files"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "manifest"
            },
            "schema_path": {
              "const": "schema.json"
            },
            "schema_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "required_domains": {
              "type": "array",
              "minItems": 7,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identity"
              }
            },
            "files": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/manifest_file"
              }
            }
          }
        }
      ]
    },
    "binding": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "sources",
            "invariants"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "model-profile-control-binding"
            },
            "sources": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "manifest_path",
                  "manifest_sha256"
                ],
                "properties": {
                  "owner": {
                    "$ref": "#/$defs/identity"
                  },
                  "manifest_path": {
                    "type": "string",
                    "pattern": "^\\.\\./"
                  },
                  "manifest_sha256": {
                    "$ref": "#/$defs/sha256"
                  }
                }
              }
            },
            "invariants": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maximum_actors",
                "simulation_tick_ns",
                "source_corpus_mode",
                "qualification_boundary"
              ],
              "properties": {
                "maximum_actors": {
                  "const": 8
                },
                "simulation_tick_ns": {
                  "const": 50000000
                },
                "source_corpus_mode": {
                  "const": "immutable"
                },
                "qualification_boundary": {
                  "const": "b0.5-implementation-only"
                }
              }
            }
          }
        }
      ]
    },
    "limits": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "wire",
            "handshake",
            "crypto",
            "replay",
            "kcp",
            "resources"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "limits"
            },
            "wire": {
              "type": "object"
            },
            "handshake": {
              "type": "object"
            },
            "crypto": {
              "type": "object"
            },
            "replay": {
              "type": "object"
            },
            "kcp": {
              "type": "object"
            },
            "resources": {
              "type": "object"
            }
          }
        }
      ]
    },
    "wire_suite": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "canonical_encoding",
            "suites"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "wire-suite"
            },
            "canonical_encoding": {
              "type": "object"
            },
            "suites": {
              "type": "array",
              "minItems": 8,
              "items": {
                "type": "object",
                "required": [
                  "suite_id",
                  "domain",
                  "cases"
                ]
              }
            }
          }
        }
      ]
    },
    "secret_policy": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "classification",
            "source_rules",
            "output_rules",
            "forbidden_property_names",
            "forbidden_patterns",
            "allowed_placeholders"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "secret-policy"
            },
            "classification": {
              "const": "low-sensitivity"
            },
            "source_rules": {
              "type": "array",
              "minItems": 3
            },
            "output_rules": {
              "type": "array",
              "minItems": 3
            },
            "forbidden_property_names": {
              "type": "array",
              "minItems": 5,
              "uniqueItems": true
            },
            "forbidden_patterns": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true
            },
            "allowed_placeholders": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "wire_layout": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "secure_header",
            "raw_route_header",
            "snapshot_acknowledgement",
            "snapshot_entity_state",
            "content_mapping",
            "kcp_segment_header",
            "kcp_route_envelope",
            "transport_control_envelope",
            "transport_control_messages",
            "datagram_equation"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "wire-layout"
            },
            "secure_header": {
              "type": "object"
            },
            "raw_route_header": {
              "type": "object"
            },
            "snapshot_acknowledgement": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_ids",
                "protobuf_field",
                "field_number",
                "scalar_type",
                "presence",
                "initial_value",
                "scope",
                "partition_policy",
                "maximum_varint_bytes",
                "maximum_datagram_bytes",
                "route_payload_budgets"
              ],
              "properties": {
                "message_ids": {
                  "const": [3002, 3003]
                },
                "protobuf_field": {
                  "const": "last_processed_input_tick"
                },
                "field_number": {
                  "const": 7
                },
                "scalar_type": {
                  "const": "uint64"
                },
                "presence": {
                  "const": "explicit-required"
                },
                "initial_value": {
                  "const": 0
                },
                "scope": {
                  "const": "authenticated-actor-and-mapping-generation"
                },
                "partition_policy": {
                  "const": "identical-across-complete-set-before-publication"
                },
                "maximum_varint_bytes": {
                  "const": 10
                },
                "maximum_datagram_bytes": {
                  "const": 1200
                },
                "route_payload_budgets": {
                  "const": {
                    "3002": 1040,
                    "3003": 900
                  }
                }
              }
            },
            "snapshot_entity_state": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_ids",
                "transform_message",
                "required_scalar_fields",
                "required_content_fields",
                "scalar_presence",
                "cross_field_invariants",
                "delta_state_mask",
                "state_flags",
                "partition_projection"
              ],
              "properties": {
                "message_ids": {
                  "const": [3002, 3003, 3005]
                },
                "transform_message": {
                  "const": "ihomeland.battle.v1.QuantizedTransform"
                },
                "required_scalar_fields": {
                  "type": "array",
                  "minItems": 7,
                  "maxItems": 7,
                  "prefixItems": [
                    {
                      "const": {
                        "name": "position_x_mm",
                        "field_number": 1,
                        "range": "sint32"
                      }
                    },
                    {
                      "const": {
                        "name": "position_y_mm",
                        "field_number": 2,
                        "range": "sint32"
                      }
                    },
                    {
                      "const": {
                        "name": "position_z_mm",
                        "field_number": 3,
                        "range": "sint32"
                      }
                    },
                    {
                      "const": {
                        "name": "yaw_millidegrees",
                        "field_number": 4,
                        "range": "[-180000,180000)"
                      }
                    },
                    {
                      "const": {
                        "name": "velocity_x_mm_per_second",
                        "field_number": 5,
                        "range": "sint32"
                      }
                    },
                    {
                      "const": {
                        "name": "velocity_y_mm_per_second",
                        "field_number": 6,
                        "range": "sint32"
                      }
                    },
                    {
                      "const": {
                        "name": "velocity_z_mm_per_second",
                        "field_number": 7,
                        "range": "sint32"
                      }
                    }
                  ],
                  "items": false
                },
                "scalar_presence": {
                  "const": "explicit-required-in-full-delta-and-spawn-state"
                },
                "required_content_fields": {
                  "const": [
                    {
                      "name": "archetype_id",
                      "field_number": 6,
                      "range": "mapped-nonzero-actor",
                      "mutability": "immutable-per-entity-generation"
                    },
                    {
                      "name": "equipped_weapon_id",
                      "field_number": 7,
                      "range": "mapped-weapon-or-zero-for-non-player",
                      "mutability": "delta-replaceable"
                    },
                    {
                      "name": "max_health_milli",
                      "field_number": 8,
                      "range": "positive-uint32",
                      "mutability": "immutable-per-entity-generation"
                    }
                  ]
                },
                "cross_field_invariants": {
                  "const": [
                    "health-milli-not-greater-than-max-health-milli",
                    "lifecycle-archetype-equals-initial-state-archetype",
                    "player-weapon-mapped-nonzero-and-non-player-weapon-zero"
                  ]
                },
                "delta_state_mask": {
                  "const": {
                    "transform": 1,
                    "health_milli": 2,
                    "state_flags": 4,
                    "equipped_weapon_id": 8,
                    "known_mask": 15,
                    "presence_policy": "exact-match"
                  }
                },
                "state_flags": {
                  "const": {
                    "phase_mask": 15,
                    "grounded_flag": 16,
                    "dead_flag": 2147483648,
                    "known_mask": 2147483679,
                    "unknown_policy": "reject",
                    "compatibility": "bits-0-through-3-remain-phase-bit-4-is-grounded-bit-31-is-dead"
                  }
                },
                "partition_projection": {
                  "const": {
                    "maximum_encoded_entity_state_bytes": 91,
                    "maximum_full_entity_entry_bytes": 93,
                    "maximum_encoded_entity_delta_bytes": 85,
                    "maximum_delta_entity_entry_bytes": 87,
                    "minimum_entities_per_full_partition": 8,
                    "minimum_entities_per_delta_partition": 8,
                    "maximum_datagram_bytes": 1200
                  }
                }
              }
            },
            "content_mapping": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_path",
                "mapping_sha256",
                "numeric_type",
                "nonzero_required",
                "retired_policy",
                "kinds"
              ],
              "properties": {
                "source_path": {
                  "const": "../../../gameplay/battle/packages/personal-world-combat-v1/wire-mapping.json"
                },
                "mapping_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "numeric_type": {
                  "const": "uint32"
                },
                "nonzero_required": {
                  "const": true
                },
                "retired_policy": {
                  "const": "never-reuse"
                },
                "kinds": {
                  "const": ["actor", "weapon", "ability", "projectile"]
                }
              }
            },
            "kcp_segment_header": {
              "type": "object"
            },
            "kcp_route_envelope": {
              "type": "object"
            },
            "transport_control_envelope": {
              "type": "object"
            },
            "transport_control_messages": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8
            },
            "datagram_equation": {
              "type": "object"
            }
          }
        }
      ]
    },
    "canonical_golden": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "encoding",
            "vectors",
            "parity_matrix"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "canonical-golden"
            },
            "encoding": {
              "const": "lowercase-hex"
            },
            "vectors": {
              "type": "array",
              "minItems": 7,
              "items": {
                "type": "object",
                "required": [
                  "vector_id",
                  "layer",
                  "bytes_hex",
                  "byte_count",
                  "sha256",
                  "decoded"
                ]
              }
            },
            "parity_matrix": {
              "type": "array",
              "minItems": 3
            }
          }
        }
      ]
    },
    "crypto_vectors": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "x25519",
            "hkdf_sha256",
            "battle_ticket_proof_key",
            "hmac_sha256",
            "chacha20_poly1305",
            "parity_implementations"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "crypto-vectors"
            },
            "x25519": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "alice_private_hex",
                "alice_public_hex",
                "bob_private_hex",
                "bob_public_hex",
                "shared_secret_hex"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "alice_private_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "alice_public_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bob_private_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bob_public_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "shared_secret_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "hkdf_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "ikm_hex",
                "salt_hex",
                "info_hex",
                "output_bytes",
                "prk_hex",
                "okm_hex"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "ikm_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "salt_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "info_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "output_bytes": {
                  "const": 42
                },
                "prk_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "okm_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{84}$"
                }
              }
            },
            "battle_ticket_proof_key": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "derivation_identity",
                "ikm_classification",
                "ikm_hex",
                "ticket_id_salt_hex",
                "output_bytes",
                "okm_hex"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "derivation_identity": {
                  "const": "ihomeland/battle-ticket/proof-key/v2"
                },
                "ikm_classification": {
                  "const": "TEST-ONLY-PUBLIC-VECTOR"
                },
                "ikm_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "ticket_id_salt_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "output_bytes": {
                  "const": 32
                },
                "okm_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "hmac_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "key_hex",
                "data_hex",
                "tag_hex"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "key_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "data_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "tag_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "chacha20_poly1305": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "key_hex",
                "nonce_hex",
                "aad_hex",
                "plaintext_hex",
                "ciphertext_hex",
                "tag_hex"
              ],
              "properties": {
                "source": {
                  "type": "string"
                },
                "key_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "nonce_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{24}$"
                },
                "aad_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "plaintext_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "ciphertext_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]+$"
                },
                "tag_hex": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            },
            "parity_implementations": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "go-stdlib-xcrypto"
                },
                {
                  "const": "cpp-libsodium-1.0.22"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    },
    "malformed_corpus": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format_version",
            "corpus_version",
            "document_kind",
            "cases",
            "policy"
          ],
          "properties": {
            "format_version": {
              "const": "1"
            },
            "corpus_version": {
              "const": "battle-wire-v1"
            },
            "document_kind": {
              "const": "malformed-corpus"
            },
            "cases": {
              "type": "array",
              "minItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "layer",
                  "mutation",
                  "expected_reason"
                ],
                "properties": {
                  "case_id": {
                    "$ref": "#/$defs/identity"
                  },
                  "layer": {
                    "$ref": "#/$defs/identity"
                  },
