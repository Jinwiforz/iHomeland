{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "document_kind",
    "identity_domain",
    "files",
    "packages"
  ],
  "properties": {
    "format_version": { "const": "gameplay-config-format-v1" },
    "document_kind": { "const": "manifest" },
    "identity_domain": { "const": "ihomeland-gameplay-config-v1" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "document_kind", "file_sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:schema|registries|packages)/[a-z0-9][a-z0-9./-]*\\.json$"
          },
          "document_kind": {
            "enum": [
              "manifest-schema",
              "package-schema",
              "authority-schema",
              "presentation-schema",
              "bindings-schema",
              "typed-reference-schema",
              "numeric-range-schema",
              "coverage-schema",
              "semantic-registry",
              "numeric-registry",
              "coverage-registry",
              "gameplay-package",
              "authority-catalog",
              "presentation-catalog",
              "external-bindings"
            ]
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "package_path", "identity_files"],
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "package_path": {
            "type": "string",
            "pattern": "^packages/[a-z0-9]+(?:-[a-z0-9]+)*/package\\.json$"
          },
          "identity_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?:schema|registries|packages)/[a-z0-9][a-z0-9./-]*\\.json$"
            }
          }
        }
      }
    }
  }
}
