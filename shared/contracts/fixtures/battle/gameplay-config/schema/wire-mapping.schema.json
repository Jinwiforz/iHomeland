{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "document_kind",
    "package_id",
    "qualification_state",
    "mappings",
    "retired_numeric_ids",
    "retired_semantic_ids"
  ],
  "properties": {
    "format_version": { "const": "gameplay-config-format-v1" },
    "document_kind": { "const": "wire-mapping" },
    "package_id": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" },
    "qualification_state": { "enum": ["governance-only", "production"] },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "semantic_id", "numeric_id"],
        "properties": {
          "kind": { "enum": ["actor", "weapon", "ability", "projectile"] },
          "semantic_id": {
            "type": "string",
            "pattern": "^(?:fixture|[a-z0-9]+(?:-[a-z0-9]+)*)/(?:actor|weapon|ability|projectile)/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "numeric_id": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
        }
      }
    },
    "retired_numeric_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 }
    },
    "retired_semantic_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/(?:actor|weapon|ability|projectile)/[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
