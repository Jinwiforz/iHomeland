# 所有可识别文本在 Git 索引中统一存储为 LF；工作区换行由本地 Git 配置决定。
* text=auto

# 源码、配置与文档始终按文本规范化。
# Unity 序列化空标量会保留冒号后的空格；相关格式继续按文本管理，但不把该原生表示判为尾随空白错误。
*.asmdef text
*.asset text whitespace=-trailing-space
*.cs text
*.editorconfig text
*.gitignore text
*.go text
*.ini text
*.json text
*.md text
*.meta text whitespace=-trailing-space
*.prefab text whitespace=-trailing-space
*.proto text
*.ps1 text
*.sh text
*.sql text eol=lf
*.toml text
*.txt text
*.unity text whitespace=-trailing-space
*.xml text
*.yaml text
*.yml text

# 二进制资源不得参与换行转换。
*.7z -text
*.a -text
*.dll -text
*.gif -text
*.ico -text
*.jpeg -text
*.jpg -text
*.lib -text
*.mp3 -text
*.mp4 -text
*.otf -text
*.pdf -text
*.png -text
*.so -text
*.ttf -text
*.wav -text
*.webm -text
*.webp -text
*.zip -text
*.bin -text
