<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/App/Modules/PersonalWorld/Content/UI/PersonalWorldTheme.uss?fileID=7433441132597879392&amp;guid=5efe5e5871a35284d9276d04c6cdec1c&amp;type=3#PersonalWorldTheme"/>
    <ui:VisualElement name="shell-root" class="ih-page" style="flex-grow: 1;">
        <ui:VisualElement name="shell-panel" class="ih-panel" style="flex-grow: 0;">
            <ui:Label text="个人世界" name="shell-title" class="ih-title"/>
            <ui:Label text="正在准备你的个人世界" name="shell-description" class="ih-subtitle"/>
            <ui:Label text="玩家ID" name="player-id-caption" class="ih-caption"/>
            <ui:Label text="-" name="player-id-label" class="ih-value"/>
            <ui:Label text="显示名称" name="display-name-caption" class="ih-caption"/>
            <ui:Label text="-" name="display-name-label" class="ih-value"/>
            <ui:Label text="当前状态" name="phase-caption" class="ih-caption"/>
            <ui:Label text="-" name="phase-label" class="ih-value"/>
            <ui:VisualElement name="shell-actions" class="ih-actions" style="flex-grow: 0;">
                <ui:Button text="重试" name="retry-button" class="ih-primary-button"/>
                <ui:Button text="退出登录" name="logout-button" class="ih-secondary-button"/>
            </ui:VisualElement>
            <ui:Label text="" name="error-label" class="ih-error"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
