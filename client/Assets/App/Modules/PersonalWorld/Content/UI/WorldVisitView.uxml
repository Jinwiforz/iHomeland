<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/App/Modules/PersonalWorld/Content/UI/PersonalWorldTheme.uss?fileID=7433441132597879392&amp;guid=5efe5e5871a35284d9276d04c6cdec1c&amp;type=3#PersonalWorldTheme"/>
    <ui:VisualElement name="world-visit-root" class="ih-page" style="flex-grow: 1;">
        <ui:VisualElement name="world-visit-panel" class="ih-panel ih-panel-wide" style="flex-grow: 0;">
            <ui:Label text="访问管理" name="world-visit-title" class="ih-title"/>
            <ui:Label text="管理个人世界邀请与访问状态" name="world-visit-description" class="ih-subtitle"/>
            <ui:VisualElement name="visit-summary" class="ih-summary-row" style="flex-grow: 0;">
                <ui:VisualElement name="role-summary" class="ih-summary-item" style="flex-grow: 1;">
                    <ui:Label text="当前角色" name="role-caption" class="ih-caption"/>
                    <ui:Label text="None" name="role-label" class="ih-value"/>
                </ui:VisualElement>
                <ui:VisualElement name="visit-session-summary" class="ih-summary-item" style="flex-grow: 1;">
                    <ui:Label text="访问会话" name="visit-session-caption" class="ih-caption"/>
                    <ui:Label text="-" name="visit-session-label" class="ih-value"/>
                </ui:VisualElement>
                <ui:VisualElement name="revision-summary" class="ih-summary-item" style="flex-grow: 1;">
                    <ui:Label text="Revision" name="revision-caption" class="ih-caption"/>
                    <ui:Label text="0" name="revision-label" class="ih-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="visit-columns" class="ih-columns" style="flex-grow: 0;">
                <ui:VisualElement name="visitor-section" class="ih-section" style="flex-grow: 1;">
                    <ui:Label text="当前访问者" name="visitor-title" class="ih-section-title"/>
                    <ui:ScrollView name="visitor-scroll" class="ih-list-scroll">
                        <ui:VisualElement name="visitor-list" class="ih-list-content" style="flex-grow: 0;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="invite-section" class="ih-section" style="flex-grow: 1;">
                    <ui:Label text="定向邀请" name="invite-title" class="ih-section-title"/>
                    <ui:ScrollView name="invite-scroll" class="ih-list-scroll">
                        <ui:VisualElement name="invite-list" class="ih-list-content" style="flex-grow: 0;"/>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:TextField label="目标玩家ID" placeholder-text="" name="target-player-input" class="ih-field"/>
            <ui:VisualElement name="owner-actions" class="ih-actions ih-actions-wrap" style="flex-grow: 0;">
                <ui:Button text="开放访问" name="open-visit-button" class="ih-primary-button"/>
                <ui:Button text="创建邀请" name="create-invite-button" class="ih-secondary-button"/>
                <ui:Button text="撤销邀请" name="revoke-invite-button" class="ih-secondary-button"/>
                <ui:Button text="移除访问者" name="kick-visitor-button" class="ih-danger-button"/>
                <ui:Button text="关闭访问" name="close-visit-button" class="ih-danger-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="visitor-actions" class="ih-actions" style="flex-grow: 0;">
                <ui:Button text="接受邀请" name="accept-invite-button" class="ih-primary-button"/>
                <ui:Button text="离开世界" name="leave-visit-button" class="ih-secondary-button"/>
            </ui:VisualElement>
            <ui:Label text="" name="error-label" class="ih-error"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
