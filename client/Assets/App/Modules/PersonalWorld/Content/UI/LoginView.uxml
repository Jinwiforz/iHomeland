<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/App/Modules/PersonalWorld/Content/UI/PersonalWorldTheme.uss?fileID=7433441132597879392&amp;guid=5efe5e5871a35284d9276d04c6cdec1c&amp;type=3#PersonalWorldTheme"/>
    <ui:VisualElement name="login-root" class="ih-page" style="flex-grow: 1;">
        <ui:VisualElement name="login-panel" class="ih-panel" style="flex-grow: 0;">
            <ui:Label text="iHomeland" name="login-title" class="ih-title"/>
            <ui:Label text="进入自己的世界" name="login-description" class="ih-subtitle"/>
            <ui:TextField label="账号" placeholder-text="" name="username-input" class="ih-field"/>
            <ui:TextField label="密码" placeholder-text="" name="password-input" password="true" class="ih-field"/>
            <ui:Toggle label="创建新账号" name="register-toggle" class="ih-toggle"/>
            <ui:TextField label="显示名称" placeholder-text="" name="display-name-input" class="ih-field"/>
            <ui:Button text="继续" name="submit-button" class="ih-primary-button"/>
            <ui:Label text="" name="error-label" class="ih-error"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
